;; Personal Kanata configuration
;;
;; QWERTY base layer with:
;; - home-row modifiers
;; - repeated Backspace/Delete/arrow actions owned by Kanata
;; - navigation layers on Esc, Z/X/C/V, G, and Space
;; - function layer on Tab and Slash
;; - F13-F24 app trigger keys for external window/app shortcuts

(defcfg
  ;; Keep unmapped keys passing through Kanata. If media/special keys behave
  ;; strangely, this is the first option to revisit.
  process-unmapped-keys yes

  concurrent-tap-hold yes
  allow-hardware-repeat false
)

(defvar
  tap-timeout        75
  hold-timeout       250
  shift-timeout      180
  repeat-tap-timeout 50
  repeat-timeout     160
  repeat-delay       15
)

;; Momentary layer aliases. Kanata's docs note that layer-toggle and
;; layer-while-held behave the same here; layer-while-held names the intent.
(defalias
  nav            (layer-while-held navigation)
  mouse-nav      (layer-while-held mouse-nav)
  shortcuts      (layer-while-held shortcuts-taskbar)
  meta-nav       (layer-while-held meta-nav)
  alt-nav        (layer-while-held alt-nav)
  shift-nav      (layer-while-held shift-nav)
  ctrl-nav       (layer-while-held ctrl-nav)
  func           (layer-while-held func)
)

;; Repeating actions. GNOME/system repeat should stay disabled so Kanata is the
;; single source of truth for held-key repeat timing.
(defalias
  scroll-up      (mwheel-up 50 120)
  scroll-down    (mwheel-down 50 120)

  rep-bspc       (tap-hold $repeat-tap-timeout $repeat-timeout bspc (macro-repeat $repeat-delay bspc))
  rep-del        (tap-hold $repeat-tap-timeout $repeat-timeout del  (macro-repeat $repeat-delay del))
  rep-left       (tap-hold $repeat-tap-timeout $repeat-timeout left (macro-repeat $repeat-delay left))
  rep-down       (tap-hold $repeat-tap-timeout $repeat-timeout down (macro-repeat $repeat-delay down))
  rep-up         (tap-hold $repeat-tap-timeout $repeat-timeout up   (macro-repeat $repeat-delay up))
  rep-rght       (tap-hold $repeat-tap-timeout $repeat-timeout rght (macro-repeat $repeat-delay rght))
)

;; Base-layer tap/hold behaviors.
(defalias
  a-met          (tap-hold $tap-timeout   $hold-timeout  a   lmet)
  s-alt          (tap-hold $tap-timeout   $hold-timeout  s   lalt)
  d-sft          (tap-hold $shift-timeout $shift-timeout d   lsft)
  f-ctl          (tap-hold $tap-timeout   $hold-timeout  f   lctl)
  j-ctl          (tap-hold $tap-timeout   $hold-timeout  j   rctl)
  k-sft          (tap-hold $shift-timeout $shift-timeout k   rsft)
  l-alt          (tap-hold $tap-timeout   $hold-timeout  l   ralt)
  quote-met      (tap-hold $tap-timeout   $hold-timeout  '   rmet)

  esc-nav        (tap-hold $tap-timeout $hold-timeout esc @nav)
  spc-mouse-nav  (tap-hold $tap-timeout $hold-timeout spc @mouse-nav)
  shortcuts-hold (tap-hold $tap-timeout $hold-timeout ;   @shortcuts)
  tab-func       (tap-hold $tap-timeout $hold-timeout tab @func)
  slash-func     (tap-hold $tap-timeout $hold-timeout /   @func)

  z-meta-nav     (tap-hold $tap-timeout $hold-timeout z @meta-nav)
  x-alt-nav      (tap-hold $tap-timeout $hold-timeout x @alt-nav)
  c-shift-nav    (tap-hold $tap-timeout $hold-timeout c @shift-nav)
  v-ctrl-nav     (tap-hold $tap-timeout $hold-timeout v @ctrl-nav)
  g-nav          (tap-hold $tap-timeout $hold-timeout g @nav)
)

;; F13-F24 trigger aliases. Wire these up in your desktop/window automation
;; layer however you like.
(defalias
  trigger-terminal   f13
  trigger-chrome     f14
  trigger-vscode     f15
  trigger-cursor     f16
  trigger-chatgpt    f17
  trigger-claude     f18
  trigger-obsidian   f19
  trigger-windsurf   f20
  trigger-sublime    f21
  trigger-chromegpt  f22
  trigger-todoist    f23
  trigger-kraken     f24
  trigger-android    C-f13
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end  ins  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /         rsft
  lctl lmet lalt           spc            ralt prtsc rctl pgdn up   pgup
                                                      left down rght
)

(deflayer base
  esc       f1       f2       f3       f4       f5       f6  f7  f8  f9  f10  f11  f12  home end  ins      @rep-del
  grv       1        2        3        4        5        6   7   8   9   0    -    =    @rep-bspc
  @tab-func q        w        e        r        t        y   u   i   o   p    [    ]    \
  @esc-nav  @a-met   @s-alt   @d-sft   @f-ctl   @g-nav   h   @j-ctl @k-sft @l-alt @shortcuts-hold @quote-met ret
  lsft      @z-meta-nav @x-alt-nav @c-shift-nav @v-ctrl-nav b n   m   ,   .   @slash-func rsft
  lctl      lmet     lalt              @spc-mouse-nav         ralt prtsc rctl pgdn @rep-up pgup
                                                                                   @rep-left @rep-down @rep-rght
)

;; General navigation layer, held by Esc or G.
(deflayer navigation
  _    f1   f2   f3   f4   f5   f6  f7   f8   f9    f10  f11  f12  home end ins @rep-del
  _    C-6  C-7  C-8  C-9  C-0  _   _    _    _     home _    _    _
  _    M-1  M-2  M-3  M-4  M-5  _   pgdn pgup M-grv _    _    _    _
  _    lmet lalt lsft lctl _    @rep-left @rep-down @rep-up @rep-rght end _ A-tab
  _    C-1  C-2  C-3  C-4  C-5  _   A-S-down C-pgup C-pgdn _         _
  _    _    _              _             _    _     _    _    _    _
                                              _    _    _
)

(deflayer meta-nav
  _    _    _    _    _    _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _    _    _    _ _ _ _ M-home _ _ _
  _    _    _    _    _    _    _ M-pgdn M-pgup _ _ _ _ _
  _    _    _    _    _    _    M-left M-down M-up M-rght M-end _ _
  _    _    lalt lsft lctl _    _ _ C-pgup C-pgdn _         _
  _    _    _              _             _ _ _ _ _ _
                                              _ _ _
)

(deflayer alt-nav
  _    _    _    _    _    _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _    _    _    _ _ _ _ A-home _ _ _
  _    _    _    _    _    _    _ A-pgdn A-pgup _ _ _ _ _
  _    _    _    _    _    _    A-left A-down A-up A-rght A-end _ _
  _    lmet _    lsft lctl _    _ _ C-pgup C-pgdn _         _
  _    _    _              _             _ _ _ _ _ _
                                              _ _ _
)

(deflayer shift-nav
  _    _    _    _    _    _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _    _    _    _ _ _ _ S-home _ _ _
  _    _    _    _    _    _    _ S-pgdn S-pgup _ _ _ _ _
  _    _    _    _    _    _    S-left S-down S-up S-rght S-end _ _
  _    lmet lalt _    lctl _    _ _ C-pgup C-pgdn _         _
  _    _    _              _             _ _ _ _ _ _
                                              _ _ _
)

(deflayer ctrl-nav
  _    _    _    _    _    _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _    _    _    _ _ _ _ C-home _ _ _
  _    _    _    _    _    _    _ C-pgdn C-pgup _ _ _ _ _
  _    _    _    _    _    _    C-left C-down C-up C-rght C-end _ _
  _    lmet lalt lsft _    _    _ _ C-pgup C-pgdn _         _
  _    _    _              _             _ _ _ _ _ _
                                              _ _ _
)

;; Preserved app-trigger layer. It is not currently bound; Semicolon uses the
;; taskbar layer below.
(deflayer shortcuts
  _    _    _    _    _    _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _    _    _    _ _ _ _ _ _ _ _
  _    q    @trigger-windsurf @trigger-android r @trigger-todoist y u i @trigger-obsidian p _ _ _
  caps @trigger-obsidian @trigger-terminal @trigger-cursor @trigger-claude @trigger-chromegpt _ _ @trigger-kraken _ @shortcuts-hold _ _
  _    @trigger-sublime @trigger-chatgpt @trigger-chrome @trigger-vscode @trigger-sublime _ _ _ _ _         _
  _    _    _              _             _ _ _ _ _ _
                                              _ _ _
)

;; Active Semicolon layer: Super+number/taskbar-style shortcuts.
(deflayer shortcuts-taskbar
  _    _   _   _   _   _   _ _ _ _ _ _ _ _ _ _ _
  _    _   _   _   _   _   _ _ _ _ _ _ _ _
  _    M-q M-w M-e M-r M-t y u M-i M-o p _ _ _
  caps M-1 M-2 M-3 M-4 M-5 _ rctl rsft ralt @shortcuts-hold _ _
  _    M-6 M-7 M-8 M-9 M-0 _ M-n M-m M-, M-.         _
  _    _   _           _          _ _ _ _ _ _
                                      _ _ _
)

(deflayer func
  _    _   _   _   _   _   _ _ _ _ _ _ _ _ _ _ _
  _    _   _   _   _   _   _ _ _ _ _ _ _ _
  _    f1  f2  f3  f4  _   _ _ _ _ _ _ _ _
  _    f5  f6  f7  f8  _   _ _ _ _ _ _ _
  _    f9  f10 f11 f12 _   _ rctl rsft ralt _         _
  _    _   _           _          _ _ _ _ _ _
                                      _ _ _
)

;; Space-held layer: navigation plus mouse wheel on U/I.
(deflayer mouse-nav
  _    f1   f2   f3   f4   f5   f6  f7   f8   f9    f10  f11  f12  home end ins @rep-del
  _    C-6  C-7  C-8  C-9  C-0  _   _    _    _     home _    _    _
  _    M-1  M-2  M-3  M-4  M-5  _   @scroll-down @scroll-up M-grv _ _ _ _
  _    lmet lalt lsft lctl _    @rep-left @rep-down @rep-up @rep-rght end _ A-tab
  _    C-1  C-2  C-3  C-4  C-5  _   pgdn C-pgup C-pgdn _         _
  _    _    _              _             _    _     _    _    _    _
                                              _    _    _
)
